  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "vite": "^6.4.1",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
